{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "english_clean": {
          "tokenizer": "standard",
          "filter": ["lowercase", "english_stop", "english_stemmer"]
        }
      },
      "filter": {
        "english_stop":    { "type": "stop",    "stopwords": "_english_" },
        "english_stemmer": { "type": "stemmer", "language":  "english"   }
      }
    }
  },
  "mappings": {
    "dynamic": "true",
    "properties": {
      "platform":       { "type": "keyword" },
      "city":           { "type": "keyword" },
      "id":             { "type": "keyword" },
      "instance":       { "type": "keyword" },
      "author":         { "type": "keyword" },
      "matched_query":  { "type": "keyword" },
      "source":         { "type": "keyword" },
      "text":           { "type": "text", "analyzer": "english_clean" },
      "url":            { "type": "keyword", "index": false },
      "created_at":     { "type": "date" },
      "lang":           { "type": "keyword" },
      "tags":           { "type": "keyword" },
      "harvested_at":   { "type": "date" }
    }
  }
}
