# ES_TLS_SERVER_NAME=elasticsearch-es-http.elastic.svc

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE=https://aus.social

